# Deny all direct web access to this directory
# The Node.js server should be run as a process, not served by Apache

# Block all requests
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

# Fallback for Apache 2.2
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>

# Extra protection for sensitive files
<FilesMatch "\.(js|json|env|md|example)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
